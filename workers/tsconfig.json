{
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.workers.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    // `node` for the builtins nodejs_compat provides. The Workers runtime itself comes from
    // worker-configuration.d.ts, which `wrangler types` generates from wrangler.jsonc — NOT from
    // @cloudflare/workers-types, which declares `process: any` and would quietly turn every
    // `process.env.X` read in the 66 handlers into `any`, taking their callers' inference with it.
    "types": ["node"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    // Mirrors wrangler.jsonc's `alias`. The server-rendered pages import Supabase by URL because
    // they also still run on Netlify's Deno edge; wrangler rewrites that specifier to the npm
    // package when it bundles, and this is how TypeScript resolves the same thing.
    // workers/__tests__/bundler-alias.test.ts keeps the two in step.
    "paths": {
      "https://esm.sh/@supabase/supabase-js@2": ["../node_modules/@supabase/supabase-js"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // The entry pulls in the route table, the adapter, all 66 handlers and all 7 renderers, so
  // typechecking this one file typechecks the whole Worker — including the api/functions/ files
  // api/tsconfig.json's own `include` list still doesn't cover.
  "include": ["index.ts", "worker-configuration.d.ts", "__tests__/**/*.ts"]
}
