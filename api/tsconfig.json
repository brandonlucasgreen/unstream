{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // Every function is typechecked, plus whatever it imports (db.ts, middleware.ts, the parsers,
  // api/search/*, api/lib/*). All of them pass strict mode since the latent errors were fixed in
  // 2026-10 (#653), so a new function is covered by being in functions/. The edge functions are
  // not: they import from URLs (esm.sh, edge.netlify.com) that only Deno resolves.
  "include": [
    "functions/*.ts",
    "functions/__tests__/search-stored.test.ts",
    "functions/__tests__/to-stored-result.test.ts",
    "functions/__tests__/newsletter-subscribe.test.ts",
    "shared/path-segments.ts",
    "functions/__tests__/path-segments.test.ts",
    "functions/__tests__/feature-flags.test.ts",
    "shared/tips-flag.ts",
    "functions/__tests__/tips-flag.test.ts",
    "shared/feed-format.ts",
    "functions/__tests__/artist-profile-remove.test.ts",
    "functions/__tests__/me-settings.test.ts",
    "functions/__tests__/me-username.test.ts",
    "functions/__tests__/me-password.test.ts",
    "functions/__tests__/feed-format.test.ts",
    "functions/__tests__/feed-releases.test.ts",
    "functions/__tests__/me-recent-releases.test.ts",
    "functions/__tests__/release-detail.test.ts",
    "functions/__tests__/release-detail-query.test.ts",
    "functions/__tests__/redis-resilience.test.ts",
    "functions/__tests__/recatalog-sweep.test.ts",
