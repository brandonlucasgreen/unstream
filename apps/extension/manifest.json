{
  "manifest_version": 3,
  "name": "Unstream - Support Music Directly",
  "description": "See where your money actually goes. Unstream shows artist payout percentages and finds them on 17 platforms. Free and open source.",
  "version": "2.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Unstream"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content/common.js", "content/spotify.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["content/common.js", "content/youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content/common.js", "content/youtube-music.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.apple.com/*"],
      "js": ["content/common.js", "content/apple-music.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.bandcamp.com/*", "https://bandcamp.com/*"],
      "js": ["content/common.js", "content/bandcamp.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://soundcloud.com/*", "https://www.soundcloud.com/*"],
      "js": ["content/common.js", "content/soundcloud.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://open.spotify.com/*",
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://music.youtube.com/*",
        "*://music.apple.com/*",
        "*://*.bandcamp.com/*",
        "*://bandcamp.com/*",
        "*://soundcloud.com/*",
        "*://www.soundcloud.com/*"
      ],
      "js": ["content/common.js", "content/generic.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://unstream.stream/*",
    "https://unstream.dev/*"
  ]
}
