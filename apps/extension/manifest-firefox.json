{
  "manifest_version": 3,
  "name": "Unstream - Support Music Directly",
  "browser_specific_settings": {
    "gecko": {
      "id": "unstream@unstream.stream",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "description": "See where your money actually goes. Unstream shows artist payout percentages and finds them on 17 platforms. Free, open source, no tracking.",
  "version": "2.3.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Unstream"
  },
  "background": {
    "scripts": ["background/service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content/common.js", "content/spotify.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["content/common.js", "content/youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content/common.js", "content/youtube-music.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.apple.com/*"],
      "js": ["content/common.js", "content/apple-music.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.bandcamp.com/*", "https://bandcamp.com/*"],
      "js": ["content/common.js", "content/bandcamp.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://soundcloud.com/*", "https://www.soundcloud.com/*"],
      "js": ["content/common.js", "content/soundcloud.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://listen.tidal.com/*",
        "https://*.tidal.com/*",
        "https://www.deezer.com/*",
        "https://www.pandora.com/*",
        "https://music.amazon.com/*",
        "https://www.amazon.com/music/*",
        "https://audius.co/*",
        "https://www.qobuz.com/*",
        "https://www.last.fm/*",
        "https://www.mixcloud.com/*",
        "https://audiomack.com/*",
        "https://www.beatport.com/*",
        "https://www.napster.com/*",
        "https://www.iheart.com/*",
        "https://tunein.com/*",
        "https://www.radio.com/*",
        "https://www.anghami.com/*",
        "https://www.jiosaavn.com/*",
        "https://gaana.com/*",
        "https://wynk.in/*",
        "https://www.boomplay.com/*",
        "https://stream.resonate.coop/*"
      ],
      "js": ["content/common.js", "content/generic.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://unstream.stream/*",
    "https://unstream.dev/*",
    "https://*.supabase.co/*"
  ]
}
