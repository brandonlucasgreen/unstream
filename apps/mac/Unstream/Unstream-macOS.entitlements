<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.scripting-targets</key>
	<dict>
		<key>com.apple.Music</key>
		<array>
			<string>com.apple.Music.playback</string>
			<!-- `.read`, not `com.apple.Music.library` — that identifier does not exist.
			     `sdef /System/Applications/Music.app` publishes exactly four groups:
			     com.apple.Music.playback, com.apple.Music.library.read,
			     com.apple.Music.library.read-write and com.apple.Music.user-interface. A
			     name matching none of them grants nothing, so every library read failed
			     with errAEPrivilegeError (-10004) while now-playing kept working — the
			     playback identifier was the one spelled right. Read-only is deliberate:
			     the import only reads. Verify any new group against the sdef. -->
			<string>com.apple.Music.library.read</string>
		</array>
		<key>com.spotify.client</key>
		<array>
			<string>com.spotify.playback</string>
		</array>
	</dict>
	<!-- Radiccio publishes no scripting access group, so scripting-targets can't cover
	     it and an exception is the only route. Without this, sandbox blocks the Apple
	     event with errAEEventNotPermitted (-1743) and Radiccio detection silently never
	     works. Parachord used to be listed here and was removed: it is read over a
	     WebSocket on port 9876, not AppleScript, so the exception did nothing.
	     Note these exceptions are fine for Developer ID + notarization but are a
	     rejection risk if the app ever goes to the Mac App Store. -->
	<key>com.apple.security.temporary-exception.apple-events</key>
	<array>
		<string>com.radiccio.mac</string>
	</array>
	<!-- Sparkle 2 in a sandboxed app talks to its installer over these two mach
	     services (the -spks / -spki suffixes are Sparkle's own naming). Without the
	     exception the Installer XPC service cannot be reached and every update fails
	     at the install step, after a successful download. Paired with
	     SUEnableInstallerLauncherService in Info-macOS.plist — both or neither.
	     No Downloader service: the app already has network.client, and Sparkle's docs
	     say not to enable both. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.lol.bgreen.unstream</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)lol.bgreen.Unstream</string>
</dict>
</plist>